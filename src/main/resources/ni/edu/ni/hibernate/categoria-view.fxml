<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.ni.hibernate.controller.CategoriaController">
    <children>
        <VBox layoutX="20.0" layoutY="20.0" prefHeight="460.0" prefWidth="560.0" spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="Gestión de Categorías">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <Label prefWidth="80.0" text="Nombre:" />
                        <TextField fx:id="txtNombre" prefWidth="200.0" promptText="Ej: Ficción" />
                    </children>
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <Label prefWidth="80.0" text="Descripción:" />
                        <TextField fx:id="txtDescripcion" prefWidth="350.0" promptText="Breve descripción de la categoría" />
                    </children>
                </HBox>

                <HBox spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#guardarCategoria" text="Guardar Categoría" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" top="5.0" />
                    </VBox.margin>
                </HBox>

                <TableView fx:id="tblCategorias" prefHeight="250.0" prefWidth="560.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
                        <TableColumn fx:id="colDescripcion" prefWidth="340.0" text="Descripción" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>